@@ -0,0 +1,11 +from flask import request, current_app, Flask

app = Flask(__name__)
@app.route('/log')
def log():
    '''
    Get the "input" from the GET request and log it as an error.
    '''
    input = request.args.get('input')
    current_app.logger.error("%s", input)
    return 'Logged'
